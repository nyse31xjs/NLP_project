  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Similarity computation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "metadata": {},
   "outputs": [],
   "source": [
    "def cosine_similarity(vec1, vec2):\n",
    "    dot_product = np.dot(vec1, vec2)\n",
    "    norm_vec1 = np.linalg.norm(vec1)\n",
    "    norm_vec2 = np.linalg.norm(vec2)\n",
    "    \n",
    "    return dot_product / (norm_vec1 * norm_vec2)\n",
    "\n",
    "def get_top_k_tweets(df, query_vector, k: int=5):\n",
    "    df['cosine_similarity'] = df['vector'].apply(lambda x: cosine_similarity(query_vector, x))\n",
    "    df = df.sort_values(by='cosine_similarity', ascending=False)\n",
    "    top_k_tweets = df.filter(['id', 'text', 'cosine_similarity']).head(k)\n",
    "    \n",
    "    return top_k_tweets"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## IR pipeline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "metadata": {},
   "outputs": [],
   "source": [
    "def IR(query, k: int=5):\n",
    "    cleaned_query = preprocess_text(query)\n",
    "    vector_query = get_doc_vector(cleaned_query)\n",
    "    top_k_tweets = get_top_k_tweets(df_tweet_vector, vector_query, k)\n",
    "    \n",
    "    return top_k_tweets"
   ]
  },
