   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Topics clusters"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Inverse document frequency"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "- We use LDA for topic modeling based on inverse document frequency.\n",
    "- We want to extract 5 topics, arbitrarily."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 145,
   "metadata": {},
   "outputs": [],
   "source": [
    "vectorizer = CountVectorizer(stop_words='english', max_features=5000)\n",
    "X = vectorizer.fit_transform(df_tweet['cleaned_text'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 148,
   "metadata": {},
   "outputs": [],
   "source": [
    "lda_model = LatentDirichletAllocation(n_components=5, random_state=42)\n",
    "lda_model.fit(X)\n",
    "\n",
    "words = vectorizer.get_feature_names_out()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 152,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Topic 1: hagupit, philippines, ymmfire, typhoon, http\n",
      "Topic 2: paris, flood, school, shooting, https\n",
      "Topic 3: dallas, help, rt, nepal, http\n",
      "Topic 4: https, pray, http, safe, earthquake\n",
      "Topic 5: alberta, hurricane, cyclone, mozambique, https\n"
     ]
    }
   ],
   "source": [
    "def display_topics(model, feature_names, num_words=5):\n",
    "    for topic_idx, topic in enumerate(model.components_):\n",
    "        top_words = [feature_names[i] for i in topic.argsort()[-num_words:]]\n",
    "        print(f\"Topic {topic_idx + 1}: {', '.join(top_words)}\")\n",
    "\n",
    "display_topics(lda_model, words)"
   ]
  },
